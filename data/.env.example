# ========================================
# HaiIntel Workflow Orchestrator - Environment Configuration
# ========================================

# Application Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=true

# LLM Configuration (Choose one provider)
LLM_PROVIDER=openai  # Options: openai, anthropic
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (Alternative to OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ticket Service Configuration
TICKET_API_URL=https://reqres.in/api/tickets
TICKET_API_TIMEOUT=30

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=support@haiintel.com

# Twilio Configuration (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#customer-support

# Workflow Configuration
REMINDER_DELAY_SECONDS=86400  # 24 hours
MAX_RETRIES=3
RETRY_DELAY=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/haiintel.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=data/analytics.db

# Security (Optional)
API_KEYS=key1,key2,key3  # Comma-separated API keys
